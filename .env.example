# Elegí UNA opción para el copiloto. Sin nada, funciona en modo offline.

# ChatGPT (API paga, requiere crédito en platform.openai.com)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=<modelo de OpenAI, ej. el que figure en platform.openai.com/docs/models>

# Gemini gratis (key en aistudio.google.com)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=<key de AI Studio>
# OPENAI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash   (lista: si uno está saturado prueba el siguiente)
# OPENAI_REASONING_EFFORT=low   (respuestas en ~4 s en lugar de ~7 s)

# Groq gratis (key en console.groq.com)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=<key de Groq>
# OPENAI_MODEL=<modelo de Groq, ej. llama-3.3-70b-versatile>

# Local con Ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# Claude (opcional)
# ANTHROPIC_API_KEY=
